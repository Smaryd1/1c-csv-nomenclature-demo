// Команды формы: Проверить и Применить.
// Реквизиты формы: ТекстДанных (Строка, неограниченная длина),
// РезультатПроверки (ТаблицаЗначений с колонками из модуля объекта).

&НаКлиенте
Процедура Проверить(Команда)
    Попытка
        ПроверитьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()

    Обработка = РеквизитФормыВЗначение("Объект");
    Результат = Обработка.ПроверитьДанные(ТекстДанных);
    ЗначениеВРеквизитФормы(Результат, "РезультатПроверки");

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)

    Оповещение = Новый ОписаниеОповещения("ПослеПодтверждения", ЭтотОбъект);
    ПоказатьВопрос(Оповещение,
        "Изменить наименования номенклатуры по результатам проверки?",
        РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт

    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Количество = ПрименитьНаСервере();
    Исключение
        Сообщить("Не удалось выполнить изменения: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Сообщить("Изменено элементов: " + Строка(Количество));

    Попытка
        ПроверитьНаСервере();
    Исключение
        Сообщить("Изменения записаны, но результат проверки не обновлён: "
            + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПрименитьНаСервере()

    Обработка = РеквизитФормыВЗначение("Объект");
    ДанныеПроверки = РеквизитФормыВЗначение("РезультатПроверки");
    Возврат Обработка.ВыполнитьИзменения(ДанныеПроверки);

КонецФункции
