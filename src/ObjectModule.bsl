// Демонстрационная внешняя обработка.
// Массовое изменение наименований существующей номенклатуры по коду.
// Формат входных данных: Код;НовоеНаименование (без CSV-кавычек).

Функция ПроверитьДанные(ТекстCSV) Экспорт

    Результат = НоваяТаблицаПроверки();
    ВстреченныеКоды = Новый Соответствие;

    ТекстCSV = СтрЗаменить(ТекстCSV, Символ(65279), "");
    ТекстCSV = СтрЗаменить(ТекстCSV, Символы.ВК, "");
    СтрокиCSV = СтрРазделить(ТекстCSV, Символы.ПС, Истина);

    Для Индекс = 0 По СтрокиCSV.Количество() - 1 Цикл

        ИсходнаяСтрока = СокрЛП(СтрокиCSV[Индекс]);
        Если ПустаяСтрока(ИсходнаяСтрока) Тогда
            Продолжить;
        КонецЕсли;

        Если Индекс = 0 И ВРег(ИсходнаяСтрока) = ВРег("Код;НовоеНаименование") Тогда
            Продолжить;
        КонецЕсли;

        СтрокаРезультата = Результат.Добавить();
        СтрокаРезультата.НомерСтроки = Индекс + 1;

        Если Найти(ИсходнаяСтрока, Символ(34)) > 0 Тогда
            УстановитьОшибку(СтрокаРезультата,
                "Кавычки в CSV не поддерживаются. Уберите их из строки.");
            Продолжить;
        КонецЕсли;

        Поля = СтрРазделить(ИсходнаяСтрока, ";", Истина);
        Если Поля.Количество() <> 2 Тогда
            УстановитьОшибку(СтрокаРезультата,
                "Ожидаются два поля: Код;НовоеНаименование.");
            Продолжить;
        КонецЕсли;

        Код = СокрЛП(Поля[0]);
        НовоеНаименование = СокрЛП(Поля[1]);

        СтрокаРезультата.Код = Код;
        СтрокаРезультата.НовоеНаименование = НовоеНаименование;

        Если ПустаяСтрока(Код) Или ПустаяСтрока(НовоеНаименование) Тогда
            УстановитьОшибку(СтрокаРезультата, "Не заполнен код или наименование.");
            Продолжить;
        КонецЕсли;

        Если ВстреченныеКоды.Получить(Код) <> Неопределено Тогда
            УстановитьОшибку(СтрокаРезультата, "Повтор кода в исходном файле.");
            Продолжить;
        КонецЕсли;

        ВстреченныеКоды.Вставить(Код, Истина);

        Номенклатура = Справочники.Номенклатура.НайтиПоКоду(Код);
        Если Номенклатура.Пустая() Тогда
            УстановитьОшибку(СтрокаРезультата, "Номенклатура с таким кодом не найдена.");
            Продолжить;
        КонецЕсли;

        СтрокаРезультата.СтароеНаименование = Номенклатура.Наименование;

        Если СтрокаРезультата.СтароеНаименование = НовоеНаименование Тогда
            СтрокаРезультата.Статус = "Без изменений";
        Иначе
            СтрокаРезультата.Статус = "Изменить";
        КонецЕсли;

    КонецЦикла;

    Возврат Результат;

КонецФункции

// При любой ошибке на этапе проверки ничего не записываем.
// Если запись одной из позиций не удалась, откатываем всю пачку.
Функция ВыполнитьИзменения(РезультатПроверки) Экспорт

    Если РезультатПроверки.Количество() = 0 Тогда
        ВызватьИсключение "Нет данных для изменения.";
    КонецЕсли;

    КоличествоИзменений = 0;

    Для Каждого СтрокаПроверки Из РезультатПроверки Цикл
        Если СтрокаПроверки.Статус = "Ошибка" Тогда
            ВызватьИсключение "Исправьте ошибки перед записью.";
        КонецЕсли;
        Если СтрокаПроверки.Статус <> "Изменить"
            И СтрокаПроверки.Статус <> "Без изменений" Тогда
            ВызватьИсключение "Неизвестный статус строки проверки.";
        КонецЕсли;
        Если СтрокаПроверки.Статус = "Изменить" Тогда
            КоличествоИзменений = КоличествоИзменений + 1;
        КонецЕсли;
    КонецЦикла;

    Если КоличествоИзменений = 0 Тогда
        Возврат 0;
    КонецЕсли;

    НачатьТранзакцию();
    Попытка

        Для Каждого СтрокаПроверки Из РезультатПроверки Цикл

            Если СтрокаПроверки.Статус <> "Изменить" Тогда
                Продолжить;
            КонецЕсли;

            Ссылка = Справочники.Номенклатура.НайтиПоКоду(СтрокаПроверки.Код);
            Если Ссылка.Пустая() Тогда
                ВызватьИсключение "Код " + СтрокаПроверки.Код + ": элемент больше не найден.";
            КонецЕсли;

            НоменклатураОбъект = Ссылка.ПолучитьОбъект();
            Если НоменклатураОбъект.Наименование <> СтрокаПроверки.СтароеНаименование Тогда
                ВызватьИсключение "Код " + СтрокаПроверки.Код
                    + ": наименование изменилось после проверки. Повторите проверку.";
            КонецЕсли;

            НоменклатураОбъект.Наименование = СтрокаПроверки.НовоеНаименование;
            НоменклатураОбъект.Записать();

        КонецЦикла;

        ЗафиксироватьТранзакцию();

    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Возврат КоличествоИзменений;

КонецФункции

Функция НоваяТаблицаПроверки()

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("СтароеНаименование", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("НовоеНаименование", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));

    Возврат Таблица;

КонецФункции

Процедура УстановитьОшибку(СтрокаРезультата, ОписаниеОшибки)

    СтрокаРезультата.Статус = "Ошибка";
    СтрокаРезультата.Комментарий = ОписаниеОшибки;

КонецПроцедуры
